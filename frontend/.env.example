# Base URL of the backend API.
#
# Development: leave this UNSET. Vite proxies /api to http://localhost:5000
# (see vite.config.ts), so requests are same-origin and there is no CORS.
#
# Production: set it to your deployed backend, INCLUDING the trailing /api,
# e.g.  VITE_API_URL=https://skillbridge-w9k8.onrender.com/api
#
# VITE_API_URL=
