# ------------------------------------------------------------------
# SkillBridge Backend Environment Variables
# Copy this file to ".env" and adjust the values.
# ------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed by CORS. Comma-separate multiple origins.
# Use the origin only (scheme + host, NO trailing slash, NO path), e.g.
#   CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Database
# Leave MONGO_URI empty to spin up an in-memory MongoDB (great for quick local testing).
# For a real database, use a MongoDB Atlas / local connection string, e.g.:
# MONGO_URI=mongodb://127.0.0.1:27017/skillbridge
MONGO_URI=

# JSON Web Token
JWT_SECRET=super_secret_change_me_in_production
JWT_EXPIRES_IN=7d
