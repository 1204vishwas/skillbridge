{
  "name": "skillbridge-backend",
  "version": "1.0.0",
  "description": "SkillBridge: Full-Stack Career Portal - REST API (Node.js + Express + MongoDB + TypeScript)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.tsx",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/utils/seed.tsx"
  },
  "keywords": [
    "career",
    "jobs",
    "express",
    "mongodb",
    "jwt",
    "typescript"
  ],
  "author": "SkillBridge",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.0",
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
